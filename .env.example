# Generate a unique 32+ byte secret for every environment.
AUTH_PEPPER=
AUTH_TRUSTED_ORIGINS=http://localhost:3000,https://your-domain.example

# Initial accounts. Values are deployment secrets and are never embedded in source or migrations.
AUTH_SEED_STUDENT_PASSWORD=
AUTH_SEED_ENTERPRISE_PASSWORD=
AUTH_SEED_ADMIN_KEY=

# Password-recovery provider. Leave unset until the sending domain is verified.
RESEND_API_KEY=
MAIL_FROM=星光计划 <no-reply@your-domain.example>
MAIL_REPLY_TO=support@your-domain.example
