# Generate a unique 32+ byte secret for every environment.
AUTH_PEPPER=
AUTH_TRUSTED_ORIGINS=http://localhost:3000,https://your-domain.example

# Initial accounts. Values are deployment secrets and are never embedded in source or migrations.
AUTH_SEED_STUDENT_PASSWORD=
AUTH_SEED_ENTERPRISE_PASSWORD=
AUTH_SEED_ADMIN_KEY=

# Password-recovery provider. Production currently uses Tencent Cloud SES API.
MAIL_PROVIDER=tencent-ses
RESEND_API_KEY=
MAIL_FROM=星光计划 <no-reply@your-domain.example>
MAIL_REPLY_TO=ruthyanghao@hotmail.com
TENCENT_SES_REGION=ap-guangzhou
TENCENT_SES_SECRET_ID=
TENCENT_SES_SECRET_KEY=
# Optional but recommended because Tencent SES accounts commonly require approved templates.
# TemplateData receives: {"code":"123456","expires":"10 分钟","product":"星光计划"}.
TENCENT_SES_TEMPLATE_ID=
